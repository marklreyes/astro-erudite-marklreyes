---
import Link from '@/components/Link.astro'
import { Badge } from '@/components/ui/badge'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

type Props = {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props

// Function to parse Markdown badge syntax and convert to HTML
function parseMarkdownBadge(markdownString: string): string {
  // Regular expression to match Markdown badge syntax: [![alt text](image url)](link url)
  const badgeRegex = /\[!\[([^\]]*)\]\(([^)]+)\)\]\(([^)]+)\)/g;

  return markdownString.replace(badgeRegex, (match, altText, imageUrl, linkUrl) => {
    return `<a href="${linkUrl}" target="_blank" rel="noopener noreferrer">
              <img src="${imageUrl}" alt="${altText}" />
            </a>`;
  });
}

// Parse the badge status if it exists
const parsedBadgeStatus = project.data.badgeStatus ? parseMarkdownBadge(project.data.badgeStatus) : null;
---

<div
  class="not-prose rounded-xl border p-4 transition-colors duration-300 ease-in-out hover:bg-secondary/50"
>
  <div class="flex flex-col gap-4 sm:flex-row">
    {
      project.data.image && (
        <div class="w-full sm:w-auto sm:max-w-[200px] sm:flex-shrink-0">
          <Image
            src={project.data.image}
            alt={project.data.name}
            width={1200}
            height={630}
            class="w-full h-auto object-cover rounded-md"
          />
        </div>
      )
    }
    <div class="flex-grow min-w-0">
      <Link
        href={project.data.link}
        class="block group"
        external
      >
        <h3 class="mb-1 text-lg font-semibold group-hover:text-primary transition-colors">
          {project.data.name}
        </h3>
        <p class="mb-2 text-sm text-muted-foreground">
          {project.data.description}
        </p>
      </Link>
      <div class="space-y-2">
        {
          project.data.tags && (
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag: string) => (
                <Badge variant="secondary" showHash={false}>
                  {tag}
                </Badge>
              ))}
            </div>
          )
        }
        {
          parsedBadgeStatus && (
            <div set:html={parsedBadgeStatus} />
          )
        }
      </div>
    </div>
  </div>
</div>
