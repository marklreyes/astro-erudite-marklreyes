---
import Container from '@/components/Container.astro'
import { Separator } from '@/components/ui/separator'
import { SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
import { parseMarkdownBadge } from '@/lib/markdown-badge'

const statusBadge = '[![Netlify Status](https://api.netlify.com/api/v1/badges/49e4824b-49bb-4830-8c3a-c3ed3b17b469/deploy-status)](https://app.netlify.com/projects/marklreyes/deploys)';

const parsedBadgeStatus = parseMarkdownBadge(statusBadge);
---

<footer class="py-4 border-t bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <Container>
    <div
      class="flex flex-col items-center justify-center gap-y-2 sm:flex-row sm:justify-between"
    >
      <div class="flex flex-col items-center gap-y-2 sm:flex-row sm:items-center sm:gap-x-2">
        <p class="flex items-center justify-center gap-x-1 text-center text-sm text-muted-foreground">
          <span>🚀 to</span>
          <span class="inline-flex items-center" set:html={parsedBadgeStatus}></span>
          <span>by</span>
          <Link
            href="/about"
            class="text-foreground"
            underline>Mark</Link>
        </p>
        <Separator orientation="vertical" className="h-4 hidden sm:block" />
        <span class="text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()} All rights reserved.
        </span>
      </div>
      <SocialIcons links={SOCIAL_LINKS} />
    </div>
  </Container>
</footer>
