---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import ContactForm from '@/components/ui/contact-form.tsx'
---

<Layout title="Contact" description={SITE.DESCRIPTION}>
	<Container class="flex flex-col gap-y-6">
	  <Breadcrumbs items={[{ label: 'Contact', icon: 'lucide:info' }]} />

	  <section>
		<div class="min-w-full">
		  <h1 class="mb-4 text-2xl font-semibold">Contact</h1>
		  <div class="flex flex-col gap-4">
			<p class="text-lg">
			  Questions, comments, or just want to say hi? Feel free to reach out!
			</p>
		  </div>

		{/* Hidden pre-rendered form for Netlify to detect during build */}
		<div style="display:none">
			<form name="contact" data-netlify="true" netlify-honeypot="bot-field">
				<input type="hidden" name="form-name" value="contact" />
				<input name="bot-field" />
				<input type="text" name="name" />
				<input type="email" name="email" />
				<textarea name="message"></textarea>
			</form>
		</div>

		<ContactForm client:load />

		</div>
	  </section>
	</Container>
</Layout>
