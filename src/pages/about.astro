---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import AuthorCard from '@/components/AuthorCard.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
const authors = await getCollection('authors')
---

<Layout title="About" description={SITE.DESCRIPTION}>
  <Container class="flex flex-col gap-y-6">
    <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

    <section>
      <div class="min-w-full">
		<h1 class="mb-4 text-2xl font-semibold">About Mark</h1>
        <div class="prose prose-neutral mb-8 dark:prose-invert">
			{
				authors.length > 0 ? (
				<ul class="not-prose flex flex-col gap-4">
					{authors.map((author) => (
					<li>
						<AuthorCard author={author} />
					</li>
					))}
				</ul>
				) : (
				<p class="text-center text-muted-foreground">No authors found.</p>
				)
			}
        </div>
		<div class="prose prose-neutral mb-8 dark:prose-invert">
			<p class="font-semibold">
				Mark is a Front-End Engineer, Podcast Producer, and Advocate crafting dynamic web experiences and scalable UI systems.
			</p>
			<p>
				He started in web marketing, but his passion for design systems, JavaScript frameworks, and tech storytelling grew into a career spanning development, digital strategy, and audio production. Today, he helps companies—from Fortune 500s to startups—deliver performant, accessible digital products that align with real goals.
			</p>
		</div>
		<h2 class="mb-4 text-2xl font-semibold">What He Does</h2>
        <div class="prose prose-neutral mb-8 dark:prose-invert">
			<ul>
				<li>
					Designs and builds front-end experiences with modern stacks like React, Angular, and Astro.
				</li>
				<li>
					Optimizes websites for performance, UX, and accessibility.
				</li>
				<li>
					Consults on web dev, podcast production, and OpenAI work at marklreyes.com.
				</li>
				<li>
					Hosts the AllWebSD podcast, highlighting San Diego’s tech community and mindful tech practices.
				</li>
				<li>
					Co-hosts The Puff Provisions Podcast, mixing humor and real life to discuss wellness, family, and canna culture.
				</li>
			</ul>
        </div>
		<h2 class="mb-4 text-2xl font-semibold">Experience Highlights</h2>
		<div class="prose prose-neutral mb-8 dark:prose-invert">
			<ul>
				<li>
					Led the responsive redesign of Thermo Fisher’s global web platform.
				</li>
				<li>
					Scaled SleepScore Labs’ web presence from launch to 100K+ visitors/month with rebrands, launches, and partner rollouts.
				</li>
				<li>
					Helped build Kinectify’s first design system with Storybook, modernizing Angular apps across teams.
				</li>
				<li>
					Produced 100+ podcast episodes to spark conversations on tech, culture, and modern life.
				</li>
			</ul>
        </div>
		<h2 class="mb-4 text-2xl font-semibold">Areas of Expertise</h2>
		<div class="prose prose-neutral mb-8 dark:prose-invert">
			<p>
				Web Development · UI Engineering · Design Systems · Podcast Production · Digital Strategy · Data Visualization · WordPress & Shopify · Performance Optimization · Teaching & Mentorship
			</p>
			<p>
				Outside of work, Mark is a Brazilian Jiu-Jitsu practitioner and volunteer coach at Gracie Barra (brown belt under Magid Hage). He mentors students on and off the mats and values time with family, finding balance and inspiration through everyday moments.
			</p>
		</div>
        <h2 class="mb-4 text-2xl font-semibold">Guardian of These Galaxies</h2>
		<p class="prose prose-neutral mb-8 dark:prose-invert">
			<em>Load the spaceship with the rocket fuel</em> and explore the collection of star systems listed below. If you have any questions or want to collaborate, don’t hesitate to reach out!
		</p>
        <div class="flex flex-col gap-4">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  </Container>
</Layout>
