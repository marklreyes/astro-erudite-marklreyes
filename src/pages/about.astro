---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Container from '@/components/Container.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import AuthorCard from '@/components/AuthorCard.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')
const authors = await getCollection('authors')
---

<Layout title="About" description={SITE.DESCRIPTION}>
  <Container class="flex flex-col gap-y-6">
    <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

    <section>
      <div class="min-w-full">
		<h1 class="mb-4 text-2xl font-semibold">About Mark</h1>
        <div class="prose prose-neutral mb-8 dark:prose-invert">
			{
				authors.length > 0 ? (
				<ul class="not-prose flex flex-col gap-4">
					{authors.map((author) => (
					<li>
						<AuthorCard author={author} />
					</li>
					))}
				</ul>
				) : (
				<p class="text-center text-muted-foreground">No authors found.</p>
				)
			}
        </div>
		<div class="prose prose-neutral mb-8 dark:prose-invert">
			<p class="font-semibold">
				I’m a Digital Technologist blending code, storytelling, and culture — building digital experiences that are performant, accessible, and human-centered.
			</p>
			<p>
				With 16+ years in front-end engineering and digital strategy, I help companies — from Fortune 500 brands to high-growth startups — deliver products that align with real-world goals. My work spans modern stacks like React, Angular, and Astro, design systems, web performance, and developer education.
			</p>
		</div>
		<h2 class="mb-4 text-2xl font-semibold">What He Does</h2>
        <div class="prose prose-neutral mb-8 dark:prose-invert">
			<ul>
				<li>
					Designs and builds front-end experiences with modern stacks like React, Angular, and Astro.
				</li>
				<li>
					Optimizes websites for performance, UX, and accessibility.
				</li>
				<li>
					Consults on web dev, podcast production, and AI Agent needs through marklreyes.com.
				</li>
				<li>
					Hosts the AllWebSD podcast, highlighting San Diego’s tech community and mindful tech practices.
				</li>
				<li>
					Co-hosts The Puff Provisions Podcast, mixing humor and real life to discuss wellness, family, and canna culture.
				</li>
			</ul>
        </div>
		<h2 class="mb-4 text-2xl font-semibold">Selected Highlights</h2>
		<div class="prose prose-neutral mb-8 dark:prose-invert">
			<ul>
				<li>
					Led the responsive redesign of Thermo Fisher’s global web platform, improving accessibility and mobile engagement across 4 continents.
				</li>
				<li>
					Scaled SleepScore Labs’ web presence to 100K+ monthly visitors, delivering multiple rebrands, launches, and partnership rollouts on aggressive timelines.
				</li>
				<li>
					Partnered in introducing Kinectify’s first design system (Storybook), accelerating UI development across Angular SaaS apps and strengthening collaboration between product and engineering teams.
				</li>
				<li>
					Produced 100+ podcast episodes, blending technical insight, community voices, and wellness conversations.
				</li>
			</ul>
        </div>
		<h2 class="mb-4 text-2xl font-semibold">Skills</h2>
		<div class="prose prose-neutral mb-8 dark:prose-invert">
			<p>
				React · Angular · Astro · JavaScript (ES6+) · TypeScript · HTML5 · CSS3/Sass · Web Performance Optimization · Accessibility (WCAG) · Responsive Design · CI/CD (Azure/AWS) · Docker · Kubernetes · UI/UX Design · Design Systems (Storybook) · Supabase · NestJS · GraphQL · WordPress · Shopify · AI Agents · Technical Communication · Public Speaking · Mentoring & Teaching
			</p>
			<p>
				Beyond code, I create content and experiences that connect people — whether through podcast interviews, developer advocacy, or mentoring. My goal: to build not just software, but the communities and cultures that thrive around it.
			</p>
		</div>
        <h2 class="mb-4 text-2xl font-semibold">Code, Storytelling & Culture</h2>
		<p class="prose prose-neutral mb-8 dark:prose-invert">
			I like building fun things for humans through these projects. If you have any questions or want to collaborate, don’t hesitate to reach out!
		</p>
        <div class="flex flex-col gap-4">
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
      </div>
    </section>
  </Container>
</Layout>
